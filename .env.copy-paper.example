# BNB Smart Chain MAINNET (chain ID 56), server-side credentials only.
# Copy this file to .env.copy-paper locally (gitignored). On Render, set the same
# variables under meme-lab-engine > Environment. Never paste keys into chat.
BSC_PRIMARY_HTTP=
BSC_PRIMARY_WS=
BSC_PRIMARY_PENDING=STANDARD_FULL
# Maximum HTTP request starts per second for the live process. Default: 8.
# Historical recovery is capped separately at 2/s; reserve that account quota.
BSC_PRIMARY_RPS=8
BSC_SECONDARY_HTTP=
BSC_SECONDARY_WS=
BSC_SECONDARY_PENDING=STANDARD_FULL
BSC_SECONDARY_RPS=8
# Archive and provider comparison are isolated from the active watcher.
BSC_ARCHIVE_HTTP=
BSC_BENCHMARK_HTTP=
BSC_BENCHMARK_WS=
ZEROX_API_KEY=
# Optional indexed history alternative. BSC support requires an eligible plan.
ETHERSCAN_API_KEY=

# Free baseline: no QuickNode account requests; PAPER-only, no signer.
BSC_FREE_BASELINE=1
# History is opt-in and must have an independent quota.
BSC_ENABLE_BACKFILL=0
BSC_ARCHIVE_SEPARATE_QUOTA=0
# BSC_ARCHIVE_DAILY_CREDITS=1000000
# Metered global pending is disabled unless explicitly budgeted.
BSC_PRIMARY_ALLOW_UNFILTERED_PENDING=0
