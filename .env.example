# Standalone: load with node --env-file=.env runtime/server.mjs
HOST=127.0.0.1
PORT=8787
DATA_DIR=.runtime
# Generated as a 0600 local file if not set. Never commit these values.
ADMIN_TOKEN=
ENCRYPTION_KEY=
# Optional Jupiter key. Quotes also support keyless limits.
JUPITER_API_KEY=
# Exact additional trusted RPC domain names, comma-separated.
ALLOWED_RPC_HOSTS=
# Wallet dedicated to bot. Restrict filesystem permissions to 0600.
SOLANA_KEYPAIR_FILE=
EVM_PRIVATE_KEY_FILE=
# Enable only behind HTTPS reverse proxy:
COOKIE_SECURE=0
# Development/test option only:
DISABLE_WORKER=0

# Optional authenticated bridge from the hosted web panel (server-only secret).
REMOTE_API_TOKEN=

# Dedicated encrypted BNB signer. Generate with npm run copy:wallet.
BNB_KEYSTORE_FILE=
BNB_PASSWORD_FILE=
